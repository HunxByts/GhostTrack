FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GHOSTTRACK_DB=/data/ghosttrack.db \
    GHOSTTRACK_SECRET_DIR=/run/secrets

WORKDIR /app
COPY web-requirements.txt requirements.txt ./
RUN python -m pip install --no-cache-dir --disable-pip-version-check -r web-requirements.txt

COPY ghosttrack/ ./ghosttrack/
COPY web/ ./web/

# The runtime is unprivileged. UID 1000 matches the default secret owner on
# common Ubuntu hosts; adjust with the documented host UID/GID if necessary.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin ghosttrack \
    && install -d -o 1000 -g 1000 /data
USER 1000:1000

EXPOSE 8000 8001
CMD ["uvicorn", "ghosttrack.web.api:public_app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-access-log"]
